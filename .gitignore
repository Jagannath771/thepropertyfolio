# ─────────────────────────────────────────────────────────────────────────────
# ThePropertyFolio — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & Environment Variables ──────────────────────────────────────────
# NEVER commit real credentials to version control.
# Use .env.example as a safe template instead.
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
.env.*.local
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
ssl/
certs/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST
.Python
lib/
lib64/
.installed.cfg
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/
.env/
virtualenv/

# Testing & Coverage
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log
backend/htmlcov/

# mypy / pyright / type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
pyrightconfig.json

# Ruff / Pylint
.ruff_cache/

# ── Node.js / Next.js ─────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Next.js build output
.next/
out/

# Nuxt.js
.nuxt/

# Vite
dist/
dist-ssr/

# Parcel
.parcel-cache/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────────────────────────────────────
# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Robot Framework
robot_results/
output.xml
log.html
report.html

# Jest
jest_output/

# ── Database ──────────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
pgdata/
postgres-data/
dump.sql
*.dump

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep docker-compose files but ignore local overrides
docker-compose.override.yml

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*
pids/
*.pid
*.seed
*.pid.lock

# ── OS ────────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ── IDEs & Editors ────────────────────────────────────────────────────────────
# VS Code (keep shared settings, ignore personal)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ── Cloud & Deployment ────────────────────────────────────────────────────────
# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# AWS
.aws/credentials

# ── Media & Uploads ───────────────────────────────────────────────────────────
# Locally uploaded files (served from S3 in production)
uploads/
media/
static/uploads/

# ── Misc ─────────────────────────────────────────────────────────────────────
# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp

# Jupyter Notebooks (checkpoints)
.ipynb_checkpoints

# Package managers
Pipfile.lock

# Screenshots used during dev (optional: remove if you want to keep them)
# screenshots/
