# ─────────────────────────────────────────────────────────────────────────────
# ThePropertyFolio — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
APP_NAME=ThePropertyFolio

# Database
POSTGRES_DB=thepropertyfolio
POSTGRES_USER=tpf_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://tpf_user:change_me_in_production@localhost:5432/thepropertyfolio

# Redis
REDIS_PASSWORD=redis_secret_change_me
REDIS_URL=redis://:redis_secret_change_me@localhost:6379/0

# Security
SECRET_KEY=generate_64_char_random_string_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
FIELD_ENCRYPTION_KEY=base64_encoded_32_byte_key_here

# NextAuth
NEXTAUTH_SECRET=generate_another_64_char_random_string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@thepropertyfolio.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# AWS S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=thepropertyfolio-media
# AWS_S3_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ThePropertyFolio

# Rate Limiting
RATE_LIMIT_CHAT_UNAUTH=30
RATE_LIMIT_CHAT_AUTH=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Celery
CELERY_BROKER_URL=redis://:redis_secret_change_me@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret_change_me@localhost:6379/2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
